# NOFX frontend (Vite dev server, port 3000, proxies /api → :8080) — the same
# serve mode the operator uses today (the Go binary does NOT serve web/dist).
# Installed alongside nofx.service by deploy/install-autostart.sh.

[Unit]
Description=NOFX frontend (vite dev server :3000)
After=network.target nofx.service

[Service]
Type=simple
User=hoang
WorkingDirectory=/home/hoang/nofx/web
# Shell redirection instead of StandardOutput=append: — the latter fails on
# this WSL2 systemd ("Failed to set up standard output: Permission denied",
# status=209/STDOUT; proven 2026-06-10 with a 127-restart crash loop).
ExecStart=/bin/sh -c 'exec /usr/bin/npm run dev >> /tmp/frontend.log 2>&1'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
