# NOFX trading backend — systemd unit (WSL2, systemd enabled).
# Install: sudo bash deploy/install-autostart.sh   (or manually:
#   sudo cp deploy/nofx.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   && sudo systemctl enable --now nofx)
#
# Notes:
# - WorkingDirectory matters: .env (godotenv) + data/data.db resolve relative
#   to it. NT_TRANSPORT=tcp now lives in .env (moved from ~/.bashrc, which a
#   service never reads).
# - /tmp/backend.log is kept via SHELL redirection in ExecStart (not
#   systemd's StandardOutput=append:) — on this WSL2 systemd, append: fails
#   with "Failed to set up standard output: Permission denied" (status=209/
#   STDOUT, proven 2026-06-10: nofx died in 1ms, nofx-web crash-looped 127×).
#   Shell redirection as User=hoang provably works (it is exactly how the
#   manual runs wrote the same file). journalctl -u nofx also keeps history.
# - Restart=on-failure + RestartSec=5: a crash auto-restarts in ≤5s; the NT8
#   AddOn (TCP client) retries every 5s, so it reconnects on its own.

[Unit]
Description=NOFX trading backend (NT8 TCP bridge, SIM-only)
After=network.target

[Service]
Type=simple
User=hoang
WorkingDirectory=/home/hoang/nofx
ExecStart=/bin/sh -c 'exec /home/hoang/nofx/nofx-bin >> /tmp/backend.log 2>&1'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
